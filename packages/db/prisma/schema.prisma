// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  INCOMPLETE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  password      String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]
  listings Listing[]
  subacriptions Subscription?
  usage Usage[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
	refreshToken      String?
  accessTokenExpiresAt DateTime?  @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope             String?
  idToken           String? @db.Text
  password          String?
  createdAt         DateTime @db.Timestamptz(3)
	updatedAt         DateTime @db.Timestamptz(3)
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime @db.Timestamptz(3)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @db.Timestamptz(3)
  updatedAt    DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
	createdAt  DateTime @db.Timestamptz(3)
	updatedAt  DateTime @db.Timestamptz(3)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}


model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  paymentCustomerId     String?            @unique
  paymentSubscriptionId String?            @unique
  plan                  Plan               @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  selectedPlatform      String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @default(now())
  optimizations Int      @default(0)
  tokensUsed    Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Listing {
  id              String   @id @default(cuid())
  userId          String
  marketplace     String
  originalTitle   String
  originalDescription String?
  originalTags    String?
  optimizedTitle  String
  optimizedDescription String
  optimizedTags   String[]
  seoScore        Int
  improvements    String[]
  improvementBreakdown Json?
  tokensUsed      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}
