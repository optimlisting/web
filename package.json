{
  "name": "optimlisting",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "db:push": "pnpm --filter @optim/db run db:push",
    "db:generate": "pnpm --filter @optim/db run db:generate",
    "db:studio": "pnpm --filter @optim/db run db:studio",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7",
      "next": "16.2.4",
      "next-auth": "5.0.0-beta.31",
      "@auth/core": "0.41.2"
    }
  }
}
