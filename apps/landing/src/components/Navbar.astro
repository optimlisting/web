    <!-- <button className="md:hidden text-white" onClick={() => setMenuOpen(!menuOpen)}>
      {menuOpen ? <X size={22} /> : <Menu size={22} />}
    </button> -->
  </div>
</nav>
<script type="module">
  import { animate, scroll } from "https://cdn.jsdelivr.net/npm/motion@latest/+esm"
  const nav = document.querySelector('nav')
  
  if (nav) {
    // Animate based on scroll position (0-20px range)
    scroll((progress) => {
      // Calculate opacity/strength based on scroll position up to 20px
      const scrollY = window.scrollY
      const intensity = Math.min(scrollY / 20, 1)
      
      animate(nav, {
        backgroundColor: `rgba(0, 0, 0, ${0.8 * intensity})`,
        backdropFilter: `blur(${10 * intensity}px)`,
        boxShadow: intensity > 0 ? '0 4px 6px rgba(0, 0, 0, 0.1)' : 'none'
      }, { duration: 0.1 }) // Short duration for smooth following
    })
  }
</script>
