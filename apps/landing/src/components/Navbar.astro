<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2">
      <img src="/optim-logo.svg" class="w-8 h-8" />
      <span class="font-bricolage font-bold text-[1.1rem] text-white">
        OptimListing
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {["Features", "Pricing"].map((item) => (
        <a
          href={`#${item.toLowerCase()}`}
          class="font-manrope font-medium text-[0.9rem] text-[#8899BB] transition-colors duration-200 hover:text-white"
        >
          {item}
        </a>
      ))}
      <a
        href="/dashboard/signin"
        class="font-manrope font-medium text-[0.9rem] text-[#8899BB] transition-colors duration-200 hover:text-white"
      >
        Sign In
      </a>
      <a
        href="/dashboard/signup"
        class="font-manrope font-semibold text-white px-4 py-2 rounded-lg text-sm transition-all duration-200 hover:opacity-90"
        style={{
          background: "linear-gradient(135deg, #7C3AED, #6D28D9)",
          boxShadow: "0 0 20px rgba(124,58,237,0.4)",
        }}
      >
        Start Free →
      </a>
