---
const year = new Date().getFullYear();
---

<footer
  class="py-16 border-t bg-[#070B18]"
  style={{ borderColor: "rgba(255,255,255,0.06)" }}
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-10 mb-12">
      {/* Brand */}
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <img src="optim-logo.svg" alt="optimlisting logo" class="w-8 h-8" />
          <span class="font-bricolage font-bold text-[#EEF2FF] text-[1.05rem]">
            OptimListing
          </span>
        </div>
        <p class="font-manrope text-[#8899BB] text-[0.85rem]" 
          style={{ lineHeight: 1.6 }}>
          AI-powered listing optimization for marketplace sellers.
        </p>
      </div>

      <div class="col-span-3 md:col-span-4">
        <div class="flex flex-col md:items-end md:justify-end space-y-6 md:space-y-3 h-full">
          <div class="flex items-center gap-2">
            <span class="font-manrope text-[0.88rem] text-[#8899BB] underline underline-offset-4">
              Connect on Social:{" "}
            </span>
            <a href="https://x.com/optimlisting" target="_blank">
              <svg class="w-auto h-3 hover:fill-white transition-colors duration-150" fill="#8899BB" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>X</title><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
            </a>
            <a href="https://linkedin.com/company/optimlisting" target="_blank">
              <svg class="group w-auto h-3" role="img" width="256" height="256" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid" viewBox="0 0 256 256"><path class="group-hover:fill-white transition-colors duration-150" d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.907 39.907 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186l-.016 67.013ZM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009-.002-12.157 9.851-22.014 22.008-22.016 12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453" fill="#8899BB"/></svg>
            </a>
          </div>
          <div class="flex items-center gap-2">
            <a href="/privacy" class="font-manrope text-[0.88rem] text-[#8899BB] transition-colors duration-150 hover:text-white">
              Privacy Policy
            </a>
            <a href="/terms" class="font-manrope text-[0.88rem] text-[#8899BB] transition-colors duration-150 hover:text-white">
              Terms of Service
            </a>
            <a href="mailto:hello@optimlisting.com" class="font-manrope text-[0.88rem] text-[#8899BB] transition-colors duration-150 hover:text-white">
              Contact
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      class="flex flex-col sm:flex-row items-center justify-between pt-8 border-t gap-4"
      style={{ borderColor: "rgba(255,255,255,0.06)" }}
    >
      <p class="order-2 md:order-0 font-manrope text-[#8899BB] text-[0.82rem]">
        © {year} OptimListing. All rights reserved.
      </p>
      <p class="font-manrope text-[#4B5568] text-[0.82rem]">
        Built for marketplace sellers who want more.
      </p>
    </div>
  </div>
</footer>
