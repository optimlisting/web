---
import { ArrowRight, Star, TrendingUp } from "@lucide/astro";
import { PLATFORMS, BEFORE_AFTER } from "../consts";
---

<section
  class="relative min-h-screen flex flex-col items-center justify-center pt-24 overflow-hidden"
  style={{ background: "#070B18" }}
>
  {/* Radial glow backgrounds */}
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] pointer-events-none"
    style={{
      background: "radial-gradient(ellipse at center top, rgba(124,58,237,0.22) 0%, transparent 70%)",
    }}
  />
  <div
    class="absolute bottom-0 right-0 w-[500px] h-[400px] pointer-events-none"
    style={{
      background: "radial-gradient(ellipse at bottom right, rgba(0,229,160,0.1) 0%, transparent 70%)",
    }}
  />

  {/* Grid overlay */}
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03]"
    style={{
      backgroundImage: "linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px)",
      backgroundSize: "60px 60px",
    }}
  />

  <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
    {/* Badge */}
    <div
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8 border"
      style={{
        background: "rgba(124,58,237,0.12)",
        borderColor: "rgba(124,58,237,0.3)",
      }}
    >
      <TrendingUp size={14} style={{ color: "#00E5A0" }} />
      <span style={{ color: "#00E5A0", fontFamily: "'Manrope Variable', sans-serif", fontSize: "0.82rem", fontWeight: 600 }}>
        AI-powered for Amazon, Shopify, Etsy & eBay
      </span>
    </div>

    {/* Headline */}
    <h1
      class="mb-6 leading-none"
      style={{
        fontFamily: "'Bricolage Grotesque Variable', sans-serif",
        fontWeight: 800,
        fontSize: "clamp(2.6rem, 7vw, 5.5rem)",
        color: "#EEF2FF",
        letterSpacing: "-0.03em",
        lineHeight: 1.05,
      }}
    >
      Turn Dead Listings Into{" "}
      <span
        style={{
          background: "linear-gradient(135deg, #7C3AED 0%, #00E5A0 100%)",
          WebkitBackgroundClip: "text",
          WebkitTextFillColor: "transparent",
        }}
      >
        Sales Machines.
      </span>
    </h1>

    {/* Subtext */}
    <p
      class="max-w-2xl mx-auto mb-10"
      style={{
        fontFamily: "'Manrope Variable', sans-serif",
        fontSize: "clamp(1rem, 2vw, 1.2rem)",
        color: "#8899BB",
        lineHeight: 1.7,
        fontWeight: 400,
      }}
    >
      OptimListing's AI rewrites your titles, descriptions, and tags to rank higher and convert faster — across every major marketplace, in seconds.
    </p>

    {/* CTAs */}
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
      <a
        href="/dashboard/signup"
        class="flex items-center gap-2 px-7 py-4 rounded-xl transition-all duration-200 hover:scale-105 hover:shadow-2xl"
        style={{
          background: "linear-gradient(135deg, #7C3AED, #5B21B6)",
          color: "#fff",
          fontFamily: "'Manrope Variable', sans-serif",
          fontWeight: 700,
          fontSize: "1rem",
          boxShadow: "0 0 32px rgba(124,58,237,0.5)",
        }}
      >
        Start Optimizing Free <ArrowRight size={18} />
      </a>
      <a
        href="#demo-card"
        class="flex items-center gap-2 px-7 py-4 rounded-xl border transition-all duration-200 hover:border-white/30"
        style={{
          borderColor: "rgba(255,255,255,0.12)",
          color: "#EEF2FF",
          fontFamily: "'Manrope Variable', sans-serif",
          fontWeight: 600,
          fontSize: "1rem",
        }}
      >
        See It In Action
      </a>
    </div>

    <div class="flex items-center justify-center gap-2 mb-16 flex-wrap">
      <span style={{ color: "#8899BB", fontFamily: "'Manrope Variable', sans-serif", fontSize: "0.85rem" }}>No credit card required</span>
      <span style={{ color: "#2D3748", fontFamily: "'Manrope Variable', sans-serif", fontSize: "0.85rem" }}>•</span>
      <span style={{ color: "#8899BB", fontFamily: "'Manrope Variable', sans-serif", fontSize: "0.85rem" }}>Cancel anytime</span>
    </div>

    {/* Platform pills */}
    <div id="demo-card" class="flex items-center justify-center gap-3 mb-12 flex-wrap">
      {PLATFORMS.map((p) => (
        <div
          class="flex items-center gap-2 px-4 py-2 rounded-full border"
          style={{
            background: p.bg,
            borderColor: `${p.color}33`,
          }}
        >
          <div class="w-2 h-2 rounded-full" style={{ background: p.color }} />
          <span class="font-manrope font-semibold text-[0.82rem]" style={{ color: p.color }}>{p.name}</span>
        </div>
      ))}
    </div>
  </div>

  {/* Before/After Demo Card */}
  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 pb-16">
    <div
      class="rounded-2xl overflow-hidden border h-[365px] sm:h-auto"
      style={{
        background: "rgba(13,19,39,0.8)",
        borderColor: "rgba(255,255,255,0.08)",
        backdropFilter: "blur(12px)",
        boxShadow: "0 40px 80px rgba(0,0,0,0.5), 0 0 60px rgba(124,58,237,0.1)",
      }}
    >
      {/* Window chrome */}
      <div class="flex items-center justify-between px-5 py-3 border-b" style={{ borderColor: "rgba(255,255,255,0.06)" }}>
        <div class="flex gap-1.5">
          <div class="w-3 h-3 rounded-full" style={{ background: "#ef4444" }} />
          <div class="w-3 h-3 rounded-full" style={{ background: "#f59e0b" }} />
          <div class="w-3 h-3 rounded-full" style={{ background: "#22c55e" }} />
        </div>
        <div class="flex items-center gap-2">
          <span
            id="window-heading"
            class="font-manrope text-[0.75rem] text-[#8899BB]"
          >
            <!-- OptimListing AI — {current.platform} -->
          </span>
        </div>
        <div class="flex gap-2">
          {BEFORE_AFTER.map((_, i) => (
            <span
              class="window-button w-2 h-2 rounded-full transition-all bg-[rgba(255,255,255,0.2)]"
            />
          ))}
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-0">
        {/* Before */}
        <div class="p-6 border-r" style={{ borderColor: "rgba(255,255,255,0.06)" }}>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-2 h-2 rounded-full" style={{ background: "#ef4444" }} />
            <span style={{ color: "#ef4444", fontFamily: "'Manrope Variable', sans-serif", fontSize: "0.75rem", fontWeight: 600, textTransform: "uppercase", letterSpacing: "0.08em" }}>Before</span>
          </div>
          <p
            id="before-text"
            class="font-manrope text-[#8899BB] text-[0.95rem]"
            style={{
              lineHeight: 1.6,
            }}
          >
            {BEFORE_AFTER[0].before}
          </p>
        </div>

        {/* After */}
        <div class="p-6 relative">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[#00E5A0]" />
              <span class="font-manrope font-semibold text-[0.75rem] text-[#00E5A0] uppercase tracking-[0.08em]">
                After — AI Optimized
              </span>
            </div>
            <span
              id="lift-badge"
              class="font-manrope text-xs font-bold text-[#00E5A0] px-2 py-0.5 rounded-md bg-[rgba(0,229,160,0.12)]"
            >
              {BEFORE_AFTER[0].lift} views
            </span>
          </div>
          <p
            id="after-text"
            class="font-manrope text-[#EEF2FF] text-[0.95rem]"
            style={{
              lineHeight: 1.6,
              animation: "fadeSlideIn 0.4s ease-out",
            }}
          >
            {BEFORE_AFTER[0].after}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
<script>
  const BEFORE_AFTER = [
    {
      platform: "Etsy",
      before: "Handmade necklace silver chain womens jewelry",
      after: "Handmade Sterling Silver Layered Chain Necklace for Women – Minimalist Boho Jewelry Gift for Her, Birthday Present, Dainty Everyday Wear",
      lift: "+247%",
    },
    {
      platform: "Amazon",
      before: "Blue yoga mat non slip thick exercise",
      after: "Premium 6mm Non-Slip Yoga Mat | Thick, Eco-Friendly TPE Exercise Mat with Alignment Lines | Ideal for Hot Yoga, Pilates & Fitness | Includes Carrying Strap",
      lift: "+189%",
    },
    {
      platform: "eBay",
      before: "Vintage camera film retro old collectible",
      after: "Vintage 1970s Canon AE-1 35mm SLR Film Camera – Fully Functional, Tested | Retro Collectible | Great Gift for Film Photography Enthusiasts",
      lift: "+312%",
    },
  ];

  let activeIndex = 0;
  const windowHeading = document.getElementById('window-heading');
  const beforeTextEl = document.getElementById('before-text');
  const afterTextEl = document.getElementById('after-text');
  const liftBadgeEl = document.getElementById('lift-badge');

  const windowButtons = document.querySelectorAll('.window-button') as NodeListOf<HTMLElement>;
  
  function updateContent() {
    if (!windowHeading) return
    if (!beforeTextEl) return
    if (!afterTextEl) return
    if (!liftBadgeEl) return

    if (windowButtons.length < 1) return
    
    // Add animation class
    beforeTextEl.style.animation = 'none';
    afterTextEl.style.animation = 'none';
    liftBadgeEl.style.animation = 'none';
    
    // Force reflow
    beforeTextEl.offsetHeight;
    
    // Update text
    const current = BEFORE_AFTER[activeIndex];
    windowHeading.textContent = "OptimListing AI — " + current.platform
    beforeTextEl.textContent = current.before;
    afterTextEl.textContent = current.after;
    liftBadgeEl.textContent = `${current.lift} views`;

    // update button color
    windowButtons.forEach((item,i) => {
      if (i === activeIndex) {
        item.style.background = "#7C3AED"
      } else {
        item.style.background = "rgba(255,255,255,0.2)"
      }
    })
    
    // Re-add animation
    beforeTextEl.style.animation = 'fadeSlideIn 0.4s ease-out';
    afterTextEl.style.animation = 'fadeSlideIn 0.4s ease-out 0.1s';
    liftBadgeEl.style.animation = 'scaleIn 0.3s ease-out';
    
    activeIndex = (activeIndex + 1) % BEFORE_AFTER.length;
  }
  
  // Initial update
  updateContent();
  
  // Set interval
  const interval = setInterval(updateContent, 4000);
  
  // Cleanup
  document.addEventListener('astro:before-swap', () => {
    clearInterval(interval);
  });
</script>
