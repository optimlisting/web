---
import { STEPS } from "../consts";
---

<section id="how-it-works" class="py-14 md:py-24 relative" style={{ background: "#070B18" }}>
  <div
    class="absolute left-0 right-0 h-px"
    style={{ background: "linear-gradient(90deg, transparent, rgba(124,58,237,0.4), transparent)", top: 0 }}
  />

  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border mb-5"
        style={{ borderColor: "rgba(124,58,237,0.3)", background: "rgba(124,58,237,0.08)" }}
      >
        <span style={{ color: "#A78BFA", fontFamily: "'Manrope Variable', sans-serif", fontSize: "0.8rem", fontWeight: 600 }}>HOW IT WORKS</span>
      </div>
      <h2
        style={{
          fontFamily: "'Bricolage Grotesque Variable', sans-serif",
          fontWeight: 800,
          fontSize: "clamp(2rem, 4vw, 3.2rem)",
          color: "#EEF2FF",
          letterSpacing: "-0.02em",
        }}
      >
        From Listing to{" "}
        <span
          style={{
            background: "linear-gradient(135deg, #7C3AED, #00E5A0)",
            WebkitBackgroundClip: "text",
            WebkitTextFillColor: "transparent",
          }}
        >
          Revenue
        </span>{" "}
        in 3 Steps
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 relative">
      {/* Connector line */}
      <div
        class="absolute top-12 left-1/6 right-1/6 h-px hidden md:block"
        style={{ background: "linear-gradient(90deg, rgba(124,58,237,0.5), rgba(0,229,160,0.5))" }}
      />

      {STEPS.map((step, i) => (
        <div class="relative text-center">
          <div class="flex items-center justify-center mb-6">
            <div
              class="w-24 h-24 rounded-full flex items-center justify-center relative z-10"
              style={{
                background: "linear-gradient(135deg, rgba(124,58,237,0.2), rgba(0,229,160,0.1))",
                border: "1px solid rgba(124,58,237,0.3)",
              }}
            >
              <span
                style={{
                  fontFamily: "'Bricolage Grotesque Variable', sans-serif",
                  fontWeight: 800,
                  fontSize: "1.8rem",
                  background: "linear-gradient(135deg, #7C3AED, #00E5A0)",
                  WebkitBackgroundClip: "text",
                  WebkitTextFillColor: "transparent",
                }}
              >
                {step.number}
              </span>
            </div>
          </div>

          <div
            class="inline-flex px-3 py-1 rounded-full mb-4 text-xs font-semibold"
            style={{
              background: "rgba(0,229,160,0.1)",
              color: "#00E5A0",
              fontFamily: "'Manrope Variable', sans-serif",
              letterSpacing: "0.04em",
            }}
          >
            {step.tag}
          </div>

          <h3
            class="mb-3"
            style={{
              fontFamily: "'Bricolage Grotesque Variable', sans-serif",
              fontWeight: 700,
              fontSize: "1.25rem",
              color: "#EEF2FF",
            }}
          >
            {step.title}
          </h3>
          <p style={{ fontFamily: "'Manrope Variable', sans-serif", color: "#8899BB", fontSize: "0.92rem", lineHeight: 1.7 }}>
            {step.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
