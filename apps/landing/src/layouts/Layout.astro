---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | OptimListing</title>
    <meta name="title" content={`${title} | OptimListing`} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://optimlisting.com/" />
    <meta property="og:title" content={`${title} | OptimListing`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/optim-logo.png" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://optimlisting.com/" />
    <meta property="twitter:title" content={`${title} | OptimListing`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/optim-logo.png" />

    <!-- Google Analytics -->
    {import.meta.env.PROD && gaId && (
      <>
        <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline type="text/partytown">
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-SW21TFY3QF');
        </script>
      </>
    )}
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="font-manrope text-foreground">
    <Navbar />
    <slot />
    <Footer />
    <!-- Loading Overlay -->
    <div id="page-loader" class="fixed inset-0 z-50 bg-[#111827]/80 backdrop-blur-sm flex items-center justify-center hidden">
      <div class="flex gap-1.5">
        {[0,1,2].map(i => (
          <div
            class="w-3 h-3 rounded-full bg-[#7C3AED]"
            style={{
              animation: `bounce 1.2s ease-in-out ${i * 0.2}s infinite`,
            }}
          />
        ))}
      </div>
    </div>
    <script>
      // Page loading transitions
      const loader = document.getElementById('page-loader');
      
      // Show loader when clicking any dashboard link
      document.querySelectorAll('a[href^="/dashboard"]').forEach(link => {
        link.addEventListener('click', () => {
          loader?.classList.remove('hidden');
        });
      });

      // Hide loader when page loads (handles back button)
      window.addEventListener('pageshow', () => {
        loader?.classList.add('hidden');
      });
    </script>
  </body>
</html>
